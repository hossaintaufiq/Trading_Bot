# ============================================================
# NEPTUNE — Environment Configuration Template
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# ---- Application ----
APP_ENV=development          # development | staging | production
APP_NAME=NEPTUNE
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true          # hot-reload in development only
BACKEND_WORKERS=1            # increase for production

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_ENV=development

# ---- Storage ----
# SQLite database path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./storage/db/neptune.db

# Parquet historical data root
HISTORICAL_DATA_DIR=./storage/historical

# Simulation output root
SIMULATION_DATA_DIR=./storage/simulations

# ---- Market Data ----
# Binance public REST API (no authentication required for public data)
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws

# Symbols to track (comma-separated)
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT

# Timeframes to maintain (comma-separated)
TRACKED_TIMEFRAMES=15m,1h,4h

# How many historical candles to backfill on startup (per symbol per timeframe)
HISTORICAL_BACKFILL_LIMIT=1000

# ---- Paper Trading Engine ----
PAPER_STARTING_EQUITY=1000.0    # USDT
PAPER_MAKER_FEE=0.001           # 0.1%
PAPER_TAKER_FEE=0.001           # 0.1%
PAPER_SLIPPAGE_PCT=0.0005       # 0.05% per side

# ---- Risk Manager ----
RISK_MAX_CONCURRENT_POSITIONS=2
RISK_MAX_RISK_PER_TRADE_PCT=0.005     # 0.5%
RISK_DAILY_LOSS_LIMIT_PCT=0.02        # 2%
RISK_MAX_DRAWDOWN_PCT=0.05            # 5%
RISK_MIN_REWARD_RISK_RATIO=1.5

# ---- Simulation Engine ----
SIM_NUM_PATHS=1000
SIM_DEFAULT_METHOD=block_bootstrap
SIM_MAX_HORIZON_CANDLES=96       # 96 × 15m = 24h

# ---- Central Brain ----
BRAIN_SCAN_INTERVAL_SECONDS=15   # how often brain polls agents
BRAIN_SIGNAL_EXPIRY_SECONDS=3600 # signals expire after 1h

# ---- Security ----
# Secret key for signed internal messages (generate with: openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ---- DO NOT ADD REAL EXCHANGE API KEYS ----
# Real-money trading is DISABLED in v1. These keys must remain empty.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

