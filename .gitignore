# ============================================================
# NEPTUNE — .gitignore
# ============================================================

# ---- Environment ----
.env
.env.local
.env.*.local
*.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.pyd

# ---- Pytest ----
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ---- Node.js / Next.js ----
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Storage — never commit large data files ----
storage/historical/**/*.parquet
storage/simulations/**/*.parquet
storage/db/*.db
storage/db/*.db-wal
storage/db/*.db-shm

# ---- SQLite ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Logs ----
logs/
*.log
*.log.*

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDEs ----
.vscode/settings.json
.idea/
*.swp
*.swo

# ---- Docker ----
.docker/

# ---- Misc ----
*.bak
*.tmp
*.temp
scratch/
